From: Sergei Golovan
Subject: Patch replaces full list of libs used by Tk by a minimal set
 of libs to avoid unnecessary dependencies of the Snack package.
Date: Thu, 22 Jul 2010 22:23:47 +0400

--- a/unix/Makefile.in
+++ b/unix/Makefile.in
@@ -35,7 +35,7 @@
 
 LIBSO     = -lc @ALIB@ @TCL_LIB_SPEC@
 
-LIBSN     = -lc @TK_LIBS@ @ALIB@ @TCL_LIB_SPEC@ @TK_LIB_SPEC@
+LIBSN     = -lc -lX11 @ALIB@ @TCL_LIB_SPEC@ @TK_LIB_SPEC@
 
 SHLIB_LD     = @SHLIB_LD@
 SHLIB_SUFFIX = @SHLIB_SUFFIX@
